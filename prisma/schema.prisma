datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum PlatformRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum ClassRole {
  STUDENT
  TEACHER
  ASSISTANT
}

// ---------------------------------------------------------
// MODEL PENGGUNA & AUTENTIKASI (Better Auth + Custom Profile)
// ---------------------------------------------------------

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Field Tambahan Profil (Sekolah Tengah Malam)
  username      String?      @unique
  displayName   String?
  bio           String?
  bannerUrl     String?
  role          PlatformRole @default(MEMBER)

  // Pengaturan Preferensi Visual Dunia (WORLD.md)
  worldSettings Json         @default("{\"graphicsQuality\":\"medium\",\"fastMode\":false,\"nightMode\":true,\"sound\":false}")

  // Kosmetik Profil Katalog (DESIGN.md)
  activeFrameId  String?
  activeEffectId String?
  activeFrame    AvatarFrame?   @relation(fields: [activeFrameId], references: [id])
  activeEffect   ProfileEffect? @relation(fields: [activeEffectId], references: [id])

  // Relasi Autentikasi Better Auth
  sessions      Session[]
  accounts      Account[]

  // Relasi Kelas
  memberships    ClassMember[]
  createdClasses Class[]       @relation("CreatedClasses")

  // Relasi Forum, Materi & Pengumuman (Tahap 6)
  threads        Thread[]
  comments       Comment[]
  materials      LearningMaterial[]
  announcements  Announcement[]

  // Relasi Chat Pribadi / DM Intra-Kelas (Tahap 7 & WORLD.md)
  conversationsInitiated Conversation[] @relation("ConversationUser1")
  conversationsReceived  Conversation[] @relation("ConversationUser2")
  messagesSent           Message[]      @relation("SentMessages")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // Hashing bawaan Better Auth untuk email & password
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------
// MODEL KATALOG KOSMETIK (DESIGN.md)
// ---------------------------------------------------------

model AvatarFrame {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  assetUrl    String
  users       User[]
  createdAt   DateTime @default(now())

  @@map("avatar_frame")
}

model ProfileEffect {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  configKey   String   // Kunci pemetaan ke komponen GSAP
  users       User[]
  createdAt   DateTime @default(now())

  @@map("profile_effect")
}

// ---------------------------------------------------------
// MODEL KELAS & ANGGOTA (WORLD.md)
// ---------------------------------------------------------

model Class {
  id          String        @id @default(cuid())
  name        String
  code        String        @unique // Kode masuk kelas (misal: "MAT-02AM")
  description String?
  roomLayout  String        @default("standard-30") // Kunci layout ruang 3D (WORLD.md)
  
  createdById String
  createdBy   User          @relation("CreatedClasses", fields: [createdById], references: [id])
  
  members       ClassMember[]
  threads       Thread[]
  materials     LearningMaterial[]
  announcements Announcement[]
  conversations Conversation[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("class")
}

model ClassMember {
  id        String    @id @default(cuid())
  userId    String
  classId   String
  role      ClassRole @default(STUDENT)
  seatIndex Int?      // Nullable: hanya STUDENT yang diberi nomor meja

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  joinedAt  DateTime  @default(now())

  @@unique([userId, classId])
  // Di PostgreSQL standar, multiple NULL di unique constraint tidak saling bentrok,
  // sehingga pengajar/asisten (seatIndex: null) tidak akan melanggar constraint ini.
  @@unique([classId, seatIndex])
  @@map("class_member")
}

// ---------------------------------------------------------
// MODEL FORUM DISKUSI (Mading Global & Papan Diskusi Kelas)
// Single Engine: classId null = Mading, classId ada = Kelas
// ---------------------------------------------------------

model Thread {
  id            String       @id @default(cuid())
  title         String
  content       String
  category      String       // Misal: "JARINGAN & SERVER", "VIRTUALISASI", "PENGUMUMAN"
  votes         Int          @default(0)
  isPinned      Boolean      @default(false)
  hasBestAnswer Boolean      @default(false)

  authorId      String
  author        User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Single Engine: null = Mading Global, non-null = Papan Diskusi Kelas
  classId       String?
  class         Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)

  comments      Comment[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([classId, createdAt])
  @@map("thread")
}

model Comment {
  id           String    @id @default(cuid())
  content      String
  isBestAnswer Boolean   @default(false)
  depth        Int       @default(1) // 1, 2, atau 3 (maksimal)

  threadId     String
  thread       Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId     String?
  parent       Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[] @relation("CommentReplies")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([threadId, parentId])
  @@map("comment")
}

// ---------------------------------------------------------
// MODEL REPOSITORI MATERI (Perpustakaan & Rak Materi Kelas)
// Single Engine: classId null = Terbuka, classId ada = Kelas
// ---------------------------------------------------------

model LearningMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  fileFormat  String   @default("PDF")
  fileSize    String   @default("1.0 MB")
  fileUrl     String

  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Single Engine: null = Perpustakaan Terbuka, non-null = Rak Materi Kelas
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classId, category])
  @@map("learning_material")
}

// ---------------------------------------------------------
// MODEL PENGUMUMAN KELAS (Papan Tulis Kelas)
// ---------------------------------------------------------

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(true)

  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, isPinned])
  @@map("announcement")
}

// ---------------------------------------------------------
// MODEL CHAT PRIBADI / DM INTRA-KELAS (WORLD.md & docs/rancangan.md)
// DM hanya diizinkan antar sesama anggota yang sekelas
// ---------------------------------------------------------

model Conversation {
  id        String    @id @default(cuid())
  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  user1Id   String
  user1     User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)

  user2Id   String
  user2     User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  messages  Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([classId, user1Id, user2Id])
  @@index([classId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

