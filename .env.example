# Neon PostgreSQL pooled connection (untuk query runtime aplikasi)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL direct connection (untuk Prisma migrate)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth Secret & Base URL
BETTER_AUTH_SECRET="kunci-rahasia-acak-minimal-32-karakter-harus-diisi"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

